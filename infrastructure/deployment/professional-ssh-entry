#!/bin/bash
# Proposed root-owned forced SSH command; never install from a writable checkout.
set -euo pipefail
command="${SSH_ORIGINAL_COMMAND:-}"
if [[ "$command" =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
    exec /usr/bin/sudo -n /usr/local/bin/bc1q21-professional-deploy "${BASH_REMATCH[1]}"
fi
printf '%s\n' 'ERROR: only deploy followed by an exact commit SHA is permitted' >&2
exit 2
